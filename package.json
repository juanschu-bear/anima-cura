{
  "name": "anima-curo",
  "version": "0.1.0",
  "private": true,
  "description": "Anima Curo – Automated rate management, bank reconciliation & dunning for medical practices, powered by AI.",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "test": "npm run test:animus && npm run test:animasign-dupguard",
    "check:schema": "tsx scripts/check-production-schema.ts",
    "check:animasign": "tsx scripts/verify-animasign-integrity.ts",
    "check:animasign-supervisor": "tsx scripts/animasign-supervisor.ts",
    "verify:prod": "npm run typecheck && npm run test && npm run check:schema && npm run check:animasign",
    "sync:animus-react": "node scripts/sync-animus-react.mjs",
    "test:animus": "tsx --test src/vendor/animus-react/__tests__/*.test.ts",
    "test:animasign-dupguard": "tsx --test src/lib/services/__tests__/animasign-*.test.ts",
    "test:animasign-dupguard-live": "RUN_LIVE_ANIMASIGN_DUPGUARD_TEST=true tsx scripts/test-animasign-duplicate-guard.ts",
    "db:migrate": "supabase db push",
    "animasign:sync-worker": "tsx scripts/animasign-sync-worker.ts",
    "db:reset": "supabase db reset",
    "cron:bank-sync": "tsx src/lib/services/bank-sync.ts",
    "cron:matching": "tsx src/lib/services/matching-engine.ts",
    "repair:offene-posten": "tsx scripts/repair-offene-posten.ts",
    "repair:animasign-pdfs": "tsx scripts/repair-animasign-signed-pdfs.ts",
    "repair:animasign-false-greens": "tsx scripts/repair-animasign-false-greens.ts",
    "cron:dunning": "tsx src/lib/services/dunning-engine.ts",
    "cron:reports": "tsx src/lib/services/report-generator.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.26.0",
    "@documenso/embed-react": "^0.6.1",
    "@signpdf/placeholder-plain": "^3.3.0",
    "@signpdf/signer-p12": "^3.3.0",
    "@signpdf/signpdf": "^3.3.0",
    "@supabase/auth-helpers-nextjs": "^0.10.0",
    "@supabase/ssr": "^0.4.0",
    "@supabase/supabase-js": "^2.45.0",
    "@types/qrcode": "^1.5.6",
    "@types/web-push": "^3.6.4",
    "@xyflow/react": "^12.10.2",
    "autoprefixer": "^10.4.0",
    "clsx": "^2.1.0",
    "date-fns": "^3.6.0",
    "date-fns-tz": "^3.1.0",
    "framer-motion": "^12.40.0",
    "livekit-client": "^2.19.2",
    "lucide-react": "^0.383.0",
    "next": "14.2.x",
    "node-forge": "^1.3.1",
    "nodemailer": "^6.9.0",
    "openai": "^6.38.0",
    "pdf-lib": "^1.17.1",
    "postcss": "^8.4.0",
    "qrcode": "^1.5.4",
    "react": "18.3.x",
    "react-dom": "18.3.x",
    "recharts": "^2.12.0",
    "resend": "^6.12.3",
    "survey-core": "^2.5.27",
    "survey-react-ui": "^2.5.27",
    "tailwind-merge": "^2.3.0",
    "tailwindcss": "^3.4.0",
    "three": "^0.184.0",
    "web-push": "^3.6.7",
    "zod": "^3.25.76",
    "zustand": "^4.5.0"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "@types/nodemailer": "^8.0.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.7",
    "@types/three": "^0.184.1",
    "playwright": "^1.60.0",
    "supabase": "^1.178.0",
    "tsx": "^4.15.0",
    "typescript": "^5.4.0"
  }
}
